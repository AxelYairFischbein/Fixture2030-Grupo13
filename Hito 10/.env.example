# Copiar a .env (ignorado por git) y completar localmente. Nunca versionar .env.
# Usuarios, contraseñas y la ruta del token no tienen valor por defecto en el código:
# si faltan, la API no arranca y el mensaje nombra la variable.

LOG_LEVEL=INFO

# MongoDB (Hito 4)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=fixture2030
MONGO_USER=completar_localmente
MONGO_PASSWORD=completar_localmente
MONGO_AUTH_DB=admin
MONGO_SERVER_SELECTION_TIMEOUT_S=2
MONGO_SOCKET_TIMEOUT_S=3

# Neo4j (Hito 5)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=completar_localmente
NEO4J_PASSWORD=completar_localmente
NEO4J_CONNECTION_TIMEOUT_S=2
NEO4J_TX_TIMEOUT_S=3

# Cassandra (Hito 6): sin autenticación en el contenedor; dejar usuario y contraseña vacíos
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
CASSANDRA_DC=datacenter1
CASSANDRA_USER=
CASSANDRA_PASSWORD=
CASSANDRA_REQUEST_TIMEOUT_S=2

# Redis (Hito 7): puerto 16379, sin contraseña en el contenedor
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PREFIJO=fixture2030:h7:demo:
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_S=0.5
REDIS_SOCKET_TIMEOUT_S=0.5

# InfluxDB 3 Core (Hito 8): ruta al archivo del token, nunca el token
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030_h8
INFLUX_TOKEN_FILE=../Hito 8/.local/admin.token
INFLUX_TIMEOUT_S=5

# InterSystems IRIS (Hito 9)
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=completar_localmente
IRIS_PASSWORD=completar_localmente
IRIS_TIMEOUT_S=3
