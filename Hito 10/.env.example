# Copiar como .env (ignorado por Git) y completar los secretos locales.
# Los valores corresponden a la API ejecutada en la notebook contra los
# contenedores de los Hitos 4 a 9, que publican sus puertos en 127.0.0.1.
# Si la API corre dentro de un contenedor, reemplazar 127.0.0.1 por host.docker.internal.

# Límite de espera para cada operación de red contra una dependencia (segundos).
DEP_TIMEOUT_SEGUNDOS=3

# Hito 4 - MongoDB
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=fixture2030
MONGO_USER=admin
MONGO_PASSWORD=

# Hito 5 - Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Hito 6 - Cassandra (sin autenticación en el laboratorio)
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios

# Hito 7 - Redis (puerto publicado 16379, sin contraseña en el laboratorio)
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_PREFIX=fixture2030:h10
SESION_TTL_SEGUNDOS=1800
CACHE_EQUIPO_TTL_SEGUNDOS=300
IDEMPOTENCIA_TTL_SEGUNDOS=86400

# Hito 8 - InfluxDB 3 Core. Usar INFLUX_TOKEN o la ruta al token local del Hito 8.
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DB=fixture2030_h8
INFLUX_TOKEN=
INFLUX_TOKEN_FILE=../Hito 8/.local/admin.token

# Hito 9 - InterSystems IRIS (usuario creado con scripts/iris_crear_usuario_api.ps1)
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=fixture_api
IRIS_PASSWORD=
