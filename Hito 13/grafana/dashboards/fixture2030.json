      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fixture_http_request_duration_seconds_bucket{job=\"fixture-api\",traffic=\"negocio\"}[2m])))",
          "legendFormat": "P95 estimado",
          "datasource": {
            "type": "prometheus",
            "uid": "fixture-prometheus"
          },
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(rate(fixture_http_request_duration_seconds_sum{job=\"fixture-api\",traffic=\"negocio\"}[2m])) / sum(rate(fixture_http_request_duration_seconds_count{job=\"fixture-api\",traffic=\"negocio\"}[2m]))",
          "legendFormat": "Media",
          "datasource": {
            "type": "prometheus",
            "uid": "fixture-prometheus"
          },
          "range": true,
          "editorMode": "code"
        }
      ]
    },
